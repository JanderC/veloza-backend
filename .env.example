DATABASE_URL="postgresql://usuario:clave@localhost:5432/velozalcambio"
JWT_SECRET=
PORT=4000

MONTOS_VE_API_KEY=
MONTOS_VE_API_URL=
DOLARAPI_BASE_URL=

# Archivos (comprobantes, documentos, WhatsApp) en Cloudflare R2, privados. Lo nuevo se sube acá.
# R2_ENDPOINT es la "S3 API" del bucket como la muestra Cloudflare (ej. https://<cuenta>.r2.cloudflarestorage.com/velozalcambio).
# Las claves salen de R2 > Manage API tokens (permiso Object Read & Write sobre el bucket).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudinary: solo para ver lo que se subió antes de R2 (y para subir, si R2 no está configurado)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (la sesión se guarda en la base: tabla wa_sesion; las API keys de IA se cargan en el panel)
# false = no conectar WhatsApp al arrancar (útil en local para no pelear la sesión con producción)
WA_AUTOSTART=false
# URL del frontend, para el enlace al panel en los mensajes al dueño
PANEL_URL=
